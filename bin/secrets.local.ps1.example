# Copiar este archivo como "secrets.local.ps1" en esta misma carpeta
# (bin/secrets.local.ps1) y reemplazar cada valor real. Ese archivo NUNCA se
# sube a git (ver .gitignore) — iniciar_ara_server.ps1 lo carga solo si
# existe, antes de las variables de Usuario de Windows.

$env:ERP_SSO_SECRET      = "PEGAR_VALOR_REAL_AQUI"
$env:ARA_SESSION_SECRET  = "PEGAR_VALOR_REAL_AQUI"
$env:DIP_SERVICE_KEY     = "PEGAR_VALOR_REAL_AQUI"
$env:ARA_ERP_URL         = "http://127.0.0.1:4050"
$env:ARA_API_PUBLICA_KEY = "PEGAR_VALOR_REAL_AQUI"
$env:ARA_SERVER_PORT     = "4050"
